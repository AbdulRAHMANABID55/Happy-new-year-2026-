<!DOCTYPE html>
<html lang="ur">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Happy New Year 2026 - Personalized Islamic Wishes">
    <title>Happy New Year 2026 🎆</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Subtle animated background */
        .bg-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(255, 215, 0, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 80%, rgba(255, 215, 0, 0.08) 0%, transparent 50%);
            z-index: 0;
            animation: bgMove 15s ease-in-out infinite;
        }

        @keyframes bgMove {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 0.6; }
        }

        /* Fireworks Canvas */
        #fireworks {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* Content Container */
        .container {
            position: relative;
            z-index: 2;
            max-width: 500px;
            margin: 0 auto;
            padding: 30px 20px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        /* Countdown Screen */
        #countdown-screen {
            text-align: center;
            animation: fadeIn 0.6s ease;
        }

        .countdown-label {
            font-size: 20px;
            color: #ffd700;
            margin-bottom: 40px;
            letter-spacing: 2px;
            opacity: 0.9;
        }

        #countdown-number {
            font-size: 120px;
            font-weight: 700;
            color: #ffd700;
            text-shadow: 0 0 40px rgba(255, 215, 0, 0.6);
            animation: countPulse 1s ease-out;
        }

        /* Sender Screen */
        #sender-screen {
            display: none;
            text-align: center;
            animation: fadeIn 0.8s ease;
        }

        .sender-label {
            font-size: 22px;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 35px;
            line-height: 1.6;
        }

        .sender-name-box {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(255, 215, 0, 0.05));
            padding: 30px 40px;
            border-radius: 20px;
            border: 2px solid rgba(255, 215, 0, 0.4);
            margin: 30px 0;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
        }

        .sender-name {
            font-size: 38px;
            font-weight: 700;
            color: #ffd700;
            text-shadow: 0 2px 20px rgba(255, 215, 0, 0.4);
            letter-spacing: 1px;
        }

        /* Main Wish Screen */
        #wish-screen {
            display: none;
            text-align: center;
            animation: fadeIn 0.8s ease;
            width: 100%;
        }

        .wish-header {
            margin-bottom: 25px;
        }

        .wish-emoji {
            font-size: 48px;
            margin-bottom: 15px;
            display: block;
            animation: float 3s ease-in-out infinite;
        }

        .wish-title {
            font-size: 32px;
            font-weight: 700;
            color: #ffd700;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        .year-display {
            font-size: 56px;
            font-weight: 800;
            background: linear-gradient(135deg, #ffd700, #ffed4e);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 35px;
            text-shadow: 0 4px 20px rgba(255, 215, 0, 0.3);
        }

        .wish-content {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            padding: 35px 30px;
            border-radius: 20px;
            border: 2px solid rgba(255, 215, 0, 0.3);
            margin-bottom: 35px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
        }

        .wish-text {
            font-size: 20px;
            line-height: 1.8;
            color: rgba(255, 255, 255, 0.95);
        }

        /* CTA Section */
        .cta-box {
            display: none;
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(255, 215, 0, 0.08));
            padding: 25px;
            border-radius: 15px;
            border: 2px solid rgba(255, 215, 0, 0.4);
            margin-bottom: 25px;
            box-shadow: 0 8px 30px rgba(255, 215, 0, 0.15);
        }

        .cta-text {
            font-size: 18px;
            color: #ffd700;
            font-weight: 600;
        }

        /* Input Section */
        .input-box {
            display: none;
            width: 100%;
            animation: fadeIn 0.8s ease;
        }

        .name-input {
            width: 100%;
            padding: 16px 24px;
            font-size: 17px;
            border: 2px solid rgba(255, 215, 0, 0.5);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.95);
            color: #333;
            margin-bottom: 18px;
            text-align: center;
            outline: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .name-input:focus {
            border-color: #ffd700;
            box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.15);
            transform: translateY(-2px);
        }

        .name-input::placeholder {
            color: #999;
        }

        /* Buttons */
        .btn-primary {
            width: 100%;
            padding: 16px 30px;
            font-size: 19px;
            font-weight: 700;
            background: linear-gradient(135deg, #25D366, #1ea952);
            color: #fff;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(37, 211, 102, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(37, 211, 102, 0.4);
        }

        .btn-primary:active {
            transform: translateY(-1px);
        }

        .btn-secondary {
            padding: 15px 40px;
            font-size: 17px;
            font-weight: 600;
            background: linear-gradient(135deg, #ffd700, #ffed4e);
            color: #1a1a2e;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(255, 215, 0, 0.3);
            margin-top: 25px;
        }

        .btn-secondary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(255, 215, 0, 0.4);
        }

        /* Ad Placeholder */
        .ad-space {
            width: 100%;
            max-width: 320px;
            height: 90px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px dashed rgba(255, 215, 0, 0.3);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 25px auto;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.4);
        }

        /* Success Overlay */
        .success-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            animation: fadeIn 0.3s ease;
        }

        .success-card {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: linear-gradient(135deg, #25D366, #1ea952);
            padding: 45px 50px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            text-align: center;
            animation: popIn 0.5s ease;
        }

        .success-icon {
            font-size: 64px;
            margin-bottom: 20px;
        }

        .success-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .success-text {
            font-size: 18px;
            opacity: 0.95;
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes countPulse {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        @keyframes popIn {
            0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
            50% { transform: translate(-50%, -50%) scale(1.05); }
            100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
        }

        /* Responsive */
        @media (max-width: 480px) {
            .container { padding: 20px 15px; }
            #countdown-number { font-size: 90px; }
            .sender-name { font-size: 32px; }
            .wish-title { font-size: 28px; }
            .year-display { font-size: 48px; }
            .wish-text { font-size: 18px; }
            .sender-name-box { padding: 25px 30px; }
            .wish-content { padding: 30px 25px; }
        }
    </style>
</head>
<body>
    <div class="bg-overlay"></div>
    <canvas id="fireworks"></canvas>
    
    <div class="container">
        <!-- Countdown Screen -->
        <div id="countdown-screen">
            <div class="countdown-label">⏳ Loading...</div>
            <div id="countdown-number">3</div>
        </div>

        <!-- Sender Screen -->
        <div id="sender-screen">
            <div class="sender-label">
                🎉 Is bande ne aapko Happy New Year ki wish ki hai 🎉
            </div>
            <div class="sender-name-box">
                <div class="sender-name" id="sender-name-display"></div>
            </div>
            <button class="btn-secondary" onclick="showWish()">Wish Dekhein</button>
            <div class="ad-space">Google AdSense</div>
        </div>

        <!-- Main Wish Screen -->
        <div id="wish-screen">
            <div class="wish-header">
                <span class="wish-emoji">🎆</span>
                <div class="wish-title">Happy New Year</div>
                <div class="year-display">2026</div>
            </div>

            <div class="wish-content">
                <div class="wish-text">
                    ALLAH aap ko is saal mein saari khushiyan ata farmaye,<br><br>
                    aap ke liye yeh saal barkat wala, kamyabi aur sukoon se bhara ho 🤲✨
                </div>
            </div>

            <div class="cta-box" id="cta-box">
                <div class="cta-text">
                    🎁 Aap bhi apna naam likh kar kisi khaas ko bhejein
                </div>
            </div>

            <div class="input-box" id="input-box">
                <input type="text" 
                       class="name-input" 
                       id="name-input" 
                       placeholder="Apna Naam Likhein" 
                       maxlength="30">
                <button class="btn-primary" onclick="shareOnWhatsApp()">
                    <span>📱</span>
                    <span>WhatsApp</span>
                </button>
            </div>

            <div class="ad-space">Google AdSense</div>
        </div>
    </div>

    <!-- Success Overlay -->
    <div class="success-overlay" id="success-overlay">
        <div class="success-card">
            <div class="success-icon">✅</div>
            <div class="success-title">Mubarak Ho!</div>
            <div class="success-text">Aapki wish bhej di gayi hai</div>
        </div>
    </div>

    <script>
        // URL parameters
        const urlParams = new URLSearchParams(window.location.search);
        const senderName = urlParams.get('from');

        // Canvas setup
        const canvas = document.getElementById('fireworks');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        let particles = [];

        class Particle {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                this.vx = (Math.random() - 0.5) * 6;
                this.vy = (Math.random() - 0.5) * 6;
                this.alpha = 1;
                this.color = `hsl(${Math.random() * 60 + 30}, 100%, ${Math.random() * 20 + 60}%)`;
                this.size = Math.random() * 2 + 1;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.vy += 0.1;
                this.alpha -= 0.01;
            }

            draw() {
                ctx.globalAlpha = this.alpha;
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function createFirework() {
            const x = Math.random() * canvas.width;
            const y = Math.random() * canvas.height * 0.5;
            for (let i = 0; i < 30; i++) {
                particles.push(new Particle(x, y));
            }
        }

        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles = particles.filter(p => {
                p.update();
                p.draw();
                return p.alpha > 0;
            });
            requestAnimationFrame(animate);
        }

        animate();
        setInterval(createFirework, 1200);

        // Countdown
        let count = 3;
        const countdownEl = document.getElementById('countdown-number');
        const countdownScreen = document.getElementById('countdown-screen');
        const senderScreen = document.getElementById('sender-screen');
        const wishScreen = document.getElementById('wish-screen');
        const inputBox = document.getElementById('input-box');
        const ctaBox = document.getElementById('cta-box');

        const interval = setInterval(() => {
            count--;
            if (count > 0) {
                countdownEl.textContent = count;
                countdownEl.style.animation = 'none';
                setTimeout(() => countdownEl.style.animation = 'countPulse 1s ease-out', 10);
            } else {
                clearInterval(interval);
                countdownScreen.style.display = 'none';
                
                if (senderName) {
                    document.getElementById('sender-name-display').textContent = senderName;
                    senderScreen.style.display = 'block';
                } else {
                    showWishScreen();
                }
            }
        }, 1000);

        function showWish() {
            senderScreen.style.display = 'none';
            showWishScreen();
        }

        function showWishScreen() {
            wishScreen.style.display = 'block';
            inputBox.style.display = 'block';
            ctaBox.style.display = 'block';
        }

        function shareOnWhatsApp() {
            const nameInput = document.getElementById('name-input');
            const userName = nameInput.value.trim();
            
            if (!userName) {
                nameInput.style.borderColor = '#ff4444';
                nameInput.placeholder = '⚠️ Naam likhein';
                nameInput.focus();
                setTimeout(() => {
                    nameInput.style.borderColor = 'rgba(255, 215, 0, 0.5)';
                    nameInput.placeholder = 'Apna Naam Likhein';
                }, 2000);
                return;
            }

            const shareUrl = `${window.location.origin}${window.location.pathname}?from=${encodeURIComponent(userName)}`;
            const message = `🎁 Mujhe yeh New Year wish mili hai, aap bhi dekhein 👇\n${shareUrl}`;
            const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(message)}`;
            
            const overlay = document.getElementById('success-overlay');
            overlay.style.display = 'block';
            
            setTimeout(() => {
                overlay.style.display = 'none';
                window.open(whatsappUrl, '_blank');
            }, 2000);
        }

        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });
    </script>
</body>
</html> 